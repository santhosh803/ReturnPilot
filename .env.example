# PostgreSQL Database URL (Neon or local)
DATABASE_URL=postgresql://username:password@ep-sample-host.neon.tech/neondb?sslmode=require

# Redis URL (Upstash or local)
# Upstash requires TLS. The ssl_cert_reqs query parameter is required by
# celery-redis when using a rediss:// URL (CERT_NONE|CERT_OPTIONAL|CERT_REQUIRED).
# For local Redis, use: redis://localhost:6379/0
REDIS_URL=rediss://default:password@sample-redis-host.upstash.io:6379?ssl_cert_reqs=CERT_NONE

# Google Cloud / Vertex AI (Gemini)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Django Configuration
DJANGO_SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS / CSRF
# DEBUG=True allows all origins locally. In production, list the browser origins that
# may call the API (comma-separated). RAILWAY_STATIC_URL is trusted for CSRF automatically.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# API Authentication (opt-in)
# When True, every API endpoint (except the webhook, which is HMAC-gated, and the token
# endpoint) requires a DRF token. Obtain one via: POST /api/auth/token/ {username,password}
# then send header: Authorization: Token <token>. Create a user with `createsuperuser`.
REQUIRE_API_AUTH=False

# LangGraph agent checkpointer (thread persistence)
# memory (default, lost on restart) | sqlite (durable file) | postgres (durable, multi-process)
# postgres requires: uv add langgraph-checkpoint-postgres
LANGGRAPH_CHECKPOINT_BACKEND=memory
# LANGGRAPH_SQLITE_PATH=agent_checkpoints.sqlite
# LANGGRAPH_POSTGRES_URL=  # falls back to DATABASE_URL when unset

# Optional: Webhook Shared Secret
# When set, POST /api/webhooks/shopify/ must present either:
#   - X-Shopify-Hmac-SHA256: base64(HMAC-SHA256(secret, raw_request_body))  [preferred]
#   - X-Webhook-Secret: <secret>  [plain compare, back-compat]
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret

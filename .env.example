# PostgreSQL Database URL (Neon or local)
DATABASE_URL=postgresql://username:password@ep-sample-host.neon.tech/neondb?sslmode=require

# Redis URL (Upstash or local)
# Upstash requires TLS. The ssl_cert_reqs query parameter is required by
# celery-redis when using a rediss:// URL (CERT_NONE|CERT_OPTIONAL|CERT_REQUIRED).
# For local Redis, use: redis://localhost:6379/0
REDIS_URL=rediss://default:password@sample-redis-host.upstash.io:6379?ssl_cert_reqs=CERT_NONE

# Google Cloud / Vertex AI (Gemini)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Django Configuration
DJANGO_SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Optional: Webhook Shared Secret
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret
